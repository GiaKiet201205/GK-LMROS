DB_NAME=gk
COMPOSE_PROJECT_NAME=gk
DB_VOLUME_NAME=gk_dbdata
AUTH_DB_VOLUME_NAME=gk_authdata
DB_PORT=15433
DB_USER=gk
DB_PASSWORD=gk

# Mat khau tao tai khoan lan dau (khong ghi de tai khoan da co)
# Bắt buộc: điền mật khẩu admin riêng trước khi chạy; không có mật khẩu mặc định.
ADMIN_PASSWORD=
# Tài xế mới dùng số điện thoại trong hồ sơ, chỉ gồm chữ số.

# Database riêng cho Auth Service
AUTH_DB_USER=gk_auth
AUTH_DB_NAME=gk_auth
AUTH_DB_PASSWORD=gk_auth
# Database riêng cho khách hàng, yêu cầu đặt đơn và thông báo
CUSTOMER_DB_NAME=gk_customer
CUSTOMER_DB_USER=gk_customer
CUSTOMER_DB_PASSWORD=gk_customer
CUSTOMER_DB_VOLUME_NAME=gk_customerdata
# Tạo giá trị riêng bằng: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-token

# Dynamic pickup -> warehouse -> delivery. No Google key is required for map links.
ROUTING_ENABLED=true
ROUTING_PROVIDER=estimate
# Mặc định cho Optimizer khi yêu cầu không có phí từ bảng cấu hình nghiệp vụ.
OPTIMIZER_FIXED_TRIP_COST=35000
GEOCODER_URL=https://photon.komoot.io
# Dùng chung cho báo cước đường bộ ở Logistics và matrix nếu ROUTING_PROVIDER=google.
# Khi chưa có key, cước hiển thị tạm tính; không xác nhận là quãng đường Google.
GOOGLE_ROUTES_API_KEY=
GOOGLE_MATRIX_MAX_POINTS=100

# Admin assistant: API key stays in Logistics only.
GK_ASSISTANT_ENABLED=false
GK_ASSISTANT_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
GK_ASSISTANT_MODEL=gpt-4.1-mini

# Google OAuth Web client ID for the customer portal (not Gemini/Maps key).
CUSTOMER_GOOGLE_CLIENT_ID=
